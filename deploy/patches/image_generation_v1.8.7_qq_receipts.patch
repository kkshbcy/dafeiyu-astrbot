+    def record_qq_image_receipt(self, task_id: str, path: str, message_id: int) -> None:
+        """Commit a OneBot receipt before its file can be removed."""
+        record = self._generation_tasks[task_id]
+        if not self._enable_generation_task_history:
+            raise OSError("QQ image delivery requires persistent task history")
+        if path not in record.result_paths or record.status != GenerationTaskStatus.SUCCEEDED:
+            raise ValueError("Invalid QQ image result")
+        receipt_paths = {**record.qq_image_receipts, path: message_id}
+        delivered_paths = list(dict.fromkeys([*record.delivered_paths, path]))
+        delivered = set(record.result_paths) <= set(delivered_paths)
+        snapshot = replace(
+            record, qq_image_receipts=receipt_paths, delivered_paths=delivered_paths,
+            delivered=delivered, delivered_at=(record.delivered_at or datetime.now()) if delivered else None,
+        )
+        self._generation_store.save([
+            snapshot if r is record else r for r in self._generation_tasks.values()
+        ])
+        record.qq_image_receipts = snapshot.qq_image_receipts
+        record.delivered_paths = snapshot.delivered_paths
+        record.delivered = snapshot.delivered
+        record.delivered_at = snapshot.delivered_at
